<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      INFRASTRUCTURE LAYER — implements interfaces defined by the inner
      layers (Domain, Application). Depends on both of them. Must never
      reference Api: Api does not (currently) reference Infrastructure in
      this skeleton, so that specific misuse is not caught by circular
      reference detection alone — see T-001 report, AC-3, "known limitation".
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartClinic.Domain\SmartClinic.Domain.csproj" />
    <ProjectReference Include="..\SmartClinic.Application\SmartClinic.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      T-004: EF Core (Backend Stack Q7/Q8, Locked) with the PostgreSQL
      provider (Q6, Locked). Needed for the DbContext and the versioned
      migrations mechanism. Pinned to an exact version for reproducibility.
      No entities/business models are defined (T-004 adds mechanism only).
      Dapper is NOT added here: it belongs to the reporting tasks.
    -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
  </ItemGroup>

</Project>
