<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      T-005 — tests for the OpenAPI staff/portal separation mechanism.
      T-006 — tests for the centralized error envelope/handling.
      Pure in-process ASP.NET Core hosting (no Docker needed) — unlike
      T-004's Testcontainers tests, these can run wherever the .NET SDK
      runs.
    -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!--
      Same version as SmartClinic.Api's reference; kept in sync by
      scripts/check-openapi-tooling.mjs. Needed directly here (not just
      transitively) for ISwaggerProvider / SwaggerGenOptions in the tests.
    -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!--
      T-006 — needed to send REAL in-process HTTP requests (to actually
      exercise GlobalExceptionHandler/UseStatusCodePages end to end) without
      binding a real socket/port. Pinned to the net8.0 shared-framework
      version already used everywhere else in this repo (T-004's EF/Npgsql,
      T-001's TargetFramework). Standard, minimal companion package for
      exactly this — not a new/broader testing framework.
    -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartClinic.Api\SmartClinic.Api.csproj" />
  </ItemGroup>

</Project>
