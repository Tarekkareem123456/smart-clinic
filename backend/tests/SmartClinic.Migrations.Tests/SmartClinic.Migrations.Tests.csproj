<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      T-004 — integration tests for the migrations pipeline. xUnit and
      Testcontainers with real PostgreSQL are the locked testing stack
      (Backend Stack Q30/Q31); no other test framework is introduced.
    -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartClinic.Infrastructure\SmartClinic.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The T-003 SQL is executed exactly as shipped (linked, not copied or
      re-implemented), so this suite proves the real bootstrap and the
      migrations work together.
    -->
    <None Include="..\..\database\bootstrap\*.sql" Link="database\bootstrap\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\database\verify\*.sql" Link="database\verify\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
